# Public local endpoints
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
PORT=8955

# Model Provider Keys (Uncomment and add the ones you have access to)
# 1. Groq (Free / High-speed)
# GROQ_API_KEY=gsk_...

# 2. NVIDIA NIM (Free / Cloud API)
# NVIDIA_API_KEY=nvapi-...

# 3. Mistral (Free / API)
# MISTRAL_API_KEY=...

# 4. OpenAI
# OPENAI_API_KEY=sk-...

# Selected Provider: 'auto', 'groq', 'nvidia', 'mistral', 'openai', or 'mock'
MODELFORGE_PROVIDER=auto

# TrueForge Harness Model Setting
TRUEFORGE_MODEL=llama-3.3-70b-versatile
