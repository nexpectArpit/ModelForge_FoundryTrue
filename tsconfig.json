{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true
  },
  "include": [
    "core/**/*",
    "mcp-servers/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "apps/**/*",
    "tests/fixtures/**/*",
    "node_modules",
    "dist"
  ]
}
